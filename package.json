{
  "name": "@creative-int/sagu-plugins",
  "version": "0.1.0",
  "private": true,
  "appRepoProfile": "distribution-plugin",
  "creativeInt": {
    "workspaceLint": {
      "allowedRootEntries": ["sagu.config.ts"]
    }
  },
  "description": "Sagu Cursor, Codex, and Claude Code plugin manifests, the sagu-dispatch and sagu-artifact skills, and MCP wiring — generated from one canonical config.",
  "keywords": [
    "sagu",
    "agent-skills",
    "mcp",
    "monitoring",
    "intelligence",
    "radars",
    "pings"
  ],
  "homepage": "https://sagu.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/creative-int/sagu-plugins.git"
  },
  "type": "module",
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".mcp.json",
    "server.json",
    "LICENSE",
    "README.md",
    "assets/logo.png",
    "skills"
  ],
  "scripts": {
    "generate": "node tooling/generate.ts",
    "check:generated": "node tooling/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "smoke": "node tooling/smoke.ts",
    "verify": "pnpm run check:generated && pnpm run typecheck && pnpm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10.28.2"
  }
}
